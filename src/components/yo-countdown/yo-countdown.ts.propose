import { LitElement, css, html } from 'lit';
import { customElement, property, state } from 'lit/decorators.js';

export interface Countdown {
  second: number;
  minute: number;
  hour: number;
  day: number;
}

const MS = {
  second: 1000,
  minute: 60000,
  hour: 3600000,
  day: 86400000,
} as const;

@customElement('yo-countdown')
export class YoCountdown extends LitElement {
  @property({ type: String }) date = '06/12/2027';

  @state() private remaining: Countdown = { day: 0, hour: 0, minute: 0, second: 0 };

  @state() private expired = false;

  private timerId?: number;

  connectedCallback() {
    super.connectedCallback();
    this.tick();
    this.start();
  }

  disconnectedCallback() {
    this.stop();
    super.disconnectedCallback();
  }

  protected updated(changed: Map<string, unknown>) {
    if (changed.has('date')) {
      this.tick();
      if (!this.expired) {
        this.start();
      }
    }
  }

  private start() {
    this.stop();
    this.timerId = window.setInterval(() => this.tick(), 1000);
  }

  private stop() {
    if (this.timerId !== undefined) {
      window.clearInterval(this.timerId);
      this.timerId = undefined;
    }
  }

  private tick() {
    const target = new Date(this.date).getTime();
    if (Number.isNaN(target)) {
      this.remaining = { day: 0, hour: 0, minute: 0, second: 0 };
      this.expired = true;
      this.stop();
      return;
    }

    const distance = target - Date.now();

    if (distance <= 0) {
      this.remaining = { day: 0, hour: 0, minute: 0, second: 0 };
      if (!this.expired) {
        this.expired = true;
        this.dispatchEvent(
          new CustomEvent('yo-countdown-finished', { bubbles: true, composed: true }),
        );
      }
      this.stop();
      return;
    }

    this.expired = false;
    this.remaining = {
      day: Math.floor(distance / MS.day),
      hour: Math.floor((distance % MS.day) / MS.hour),
      minute: Math.floor((distance % MS.hour) / MS.minute),
      second: Math.floor((distance % MS.minute) / MS.second),
    };
  }

  render() {
    if (this.expired) {
      return html`<p part="finished">Ups...</p>`;
    }
    const { day, hour, minute, second } = this.remaining;
    return html`
      <div class="yo-countdown__content">
        <span part="day">${day} D</span>
        <span part="hour">${hour} H</span>
        <span part="minute">${minute} M</span>
        <span part="second">${second} S</span>
      </div>
    `;
  }

  static styles = css`
    :host {
      display: block;
    }
    .yo-countdown__content {
      display: flex;
      gap: 0.5em;
    }
  `;
}

declare global {
  interface HTMLElementTagNameMap {
    'yo-countdown': YoCountdown;
  }
}
