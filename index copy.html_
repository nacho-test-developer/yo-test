<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="/vite.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Vite + Lit + TS</title>
    <link rel="stylesheet" href="./src/index.css" />
    <script type="module" src="/src/components/yo-button/yo-button.ts"></script>
    <script type="module" src="/src/components/yo-card/yo-card.ts"></script>
    <script type="module" src="/src/components/yo-image/yo-image.ts"></script>
    <!-- <script type="module" src="/src/my-element.ts"></script> -->
  </head>
  <body>
    <!-- <yo-button docsHint="yep" example="ok">
      <h1 slot="suffix">Click</h1>
    </yo-button>
    <my-element></my-element> -->
    <main>
      <p class="example">Lorem ipsum dolor sit amet consectetur adipisicing elit. Laboriosam ducimus reprehenderit itaque cupiditate ipsam assumenda placeat. Rerum esse placeat temporibus provident, enim corporis, est deleniti dolorem quasi pariatur consequatur dolores?</div>
      <div class="ui-grid">
        <yo-card>
          <p>Lorem, ipsum dolor sit amet consectetur adipisicing elit. Totam commodi unde error nihil. Quisquam blanditiis ipsam aspernatur possimus in dolorem odio, dolorum ab, optio corrupti labore sint doloribus laborum ducimus?</p>
          <yo-image slot="image"></yo-image>
          <yo-button ui="full" slot="actions">Hola</yo-button>
        </yo-card>
        <yo-card>
          <p>Lorem, ipsum dolor sit amet </p>
          <yo-image slot="image"></yo-image>
          <yo-button ui="full" slot="actions">Chau</yo-button>
        </yo-card>
        <yo-card>
          <p>Lorem, ipsum dolor sit amet consectetur adipisicing elit. Totam commodi unde error nihil. Quisquam blanditiis ipsam aspernatur possimus in dolorem odio, dolorum ab, optio corrupti labore sint doloribus laborum ducimus?</p>
          <yo-image slot="image"></yo-image>
        </yo-card>
      </div>
    </main>
  </body>
</html>
